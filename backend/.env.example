# Postgres in production; SQLite default works for local dev.
DATABASE_URL=postgresql+psycopg://sangyan:sangyan@localhost:5432/sangyan
CORS_ORIGINS=["https://your-frontend.example"]
EXTENSION_ORIGINS=["chrome-extension://<your-extension-id>"]
RATE_LIMIT=20/minute
DAILY_PAID_CALL_CAP=500

# URL intel (a missing key means that check is skipped and listed as such, never faked)
SAFE_BROWSING_KEY=

# LLM: any OpenAI-compatible endpoint (extraction + wording only; never the verdict)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=sarvam-m

# Sarvam speech (verify parameters against the API reference)
SARVAM_API_KEY=

# Demo: DEMO_RECORD=1 once with network to record sources, then DEMO_REPLAY=1 on stage
DEMO_REPLAY=0
DEMO_RECORD=0
